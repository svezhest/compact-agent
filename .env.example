# OpenAI-compatible LLM endpoint used by `compact` (and by `describe` unless VISION_* is set)
API_BASE=https://api.openai.com/v1
API_KEY=sk-...
MODEL_NAME=gpt-4o-mini

# The one sizing knob: the model's context window in tokens (default 32000)
MAX_CONTEXT_TOKENS=32000
# Share of the window given to the summary side (system prompt + section views); default 0.333
# SUMMARY_SHARE=0.333

# Optional separate vision endpoint for `describe --photos` (defaults to the values above)
# VISION_BASE=http://localhost:8080/v1
# VISION_KEY=local
# VISION_MODEL=some-vision-model
